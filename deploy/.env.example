# Copy to deploy/.env (git-ignored) and fill in. Never put real values here:
# this file is committed. deploy.sh creates deploy/.env from it on the first run.

# Cesium ion access token (World Terrain). It is sent to browsers by design.
CESIUM_ION_TOKEN=

# Random secret for Django; deploy.sh generates one. Changing it signs admins out.
DJANGO_SECRET_KEY=

# The public host name(s) of the site, comma-separated, e.g. portal.example.org
ALLOWED_HOSTS=
# The site's origin(s), for form posts over HTTPS, e.g. https://portal.example.org
CSRF_TRUSTED_ORIGINS=

# Serve under a path, e.g. /moana (nginx strips it before proxying); empty for the root.
BASE_PATH=

# The host folder people can browse and open, mounted read-only at /data.
DATA_PATH=/srv/data

# Port on the host that nginx proxies to. 127.0.0.1 keeps the app reachable only
# through nginx.
APP_PORT=3130
APP_BIND=127.0.0.1

# nginx serves HTTPS and sets X-Forwarded-Proto; set false only for plain-HTTP testing.
BEHIND_PROXY=true

# Files sent from browsers for a quick look: largest accepted, and how long they're kept.
# nginx's client_max_body_size must allow MAX_UPLOAD_MB (deploy.sh prints the setting).
MAX_UPLOAD_MB=4096
TEMP_UPLOAD_HOURS=24

# gunicorn: processes, threads each, and request timeout in seconds (point clouds
# convert to 3D Tiles during the first open, which can take minutes).
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=1800

# Optional: private S3 buckets (public ones need nothing).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
